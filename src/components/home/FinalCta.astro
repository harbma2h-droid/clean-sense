---
import Icon from '../Icon.astro';
import { SITE } from '../../data/site';
import { ui, waLink } from '../../i18n/ui';
import type { Lang } from '../../data/services';

interface Props {
  lang: Lang;
  title?: string;
  text?: string;
  message?: string;
}
const { lang, title, text, message } = Astro.props;
const t = ui[lang];
---

<section class="final">
  <div class="container final__inner reveal">
    <h2 class="h2">{title ?? t.final.title}</h2>
    <p class="lead">{text ?? t.final.sub}</p>
    <div class="final__ctas">
      <a class="btn btn--gold btn--lg" href={waLink(message ?? t.wa.general)} target="_blank" rel="noopener" data-wa="final">
        <Icon name="whatsapp" size={22} />
        {t.cta.whatsapp}
      </a>
      <a class="btn btn--ghost-light btn--lg" href={`tel:${SITE.phone}`} data-track="call">
        <Icon name="phone" size={20} />
        <span dir="ltr">{SITE.phoneDisplay}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .final {
    padding-block: 72px;
    background:
      radial-gradient(600px 300px at 50% 0%, rgba(209, 173, 69, 0.22), transparent 70%),
      var(--navy);
    color: var(--on-dark-muted);
    text-align: center;
  }
  .final .h2 {
    color: #fff;
  }
  .final .lead {
    color: var(--on-dark-muted);
  }
  .final__inner {
    max-width: 720px;
  }
  .final__ctas {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  @media (min-width: 560px) {
    .final__ctas {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
  @media (min-width: 900px) {
    .final {
      padding-block: 96px;
    }
  }
</style>
