---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import villa from '../../assets/images/villa.jpg';
import { teamPhoto } from '../../lib/photos';
import { STATS } from '../../data/site';
import { ui, waLink } from '../../i18n/ui';
import type { Lang } from '../../data/services';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
// The real team photo when it is in the project; the interior photo until then.
const photo = teamPhoto ?? villa;
const photoAlt = teamPhoto ? t.team.alt : '';
---

<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="hero__badge">
        <Icon name="map-pin" size={16} />
        {t.hero.badge}
      </p>
      <h1 class="hero__title">
        {t.hero.title1}
        <span class="gold-text">{t.hero.title2}</span>
      </h1>
      <p class="hero__sub">{t.hero.sub}</p>

      <div class="hero__ctas">
        <a class="btn btn--gold btn--lg" href={waLink(t.wa.general)} target="_blank" rel="noopener" data-wa="hero">
          <Icon name="whatsapp" size={22} />
          {t.hero.primary}
        </a>
        <a class="btn btn--ghost-light btn--lg" href="#booking">
          <Icon name="calculator" size={20} />
          {t.hero.secondary}
        </a>
      </div>

      <ul class="hero__points">
        {t.hero.points.map((p) => (
          <li><Icon name="circle-check" size={18} />{p}</li>
        ))}
      </ul>

      {/* Phones: the photo under the buttons, so the first screen is not text only. */}
      <figure class="hero__mobile-photo">
        <Image src={photo} alt={photoAlt} width={720} widths={[400, 600, 720]} sizes="92vw" loading="eager" />
        <figcaption class="hero__mobile-chip"><Icon name="shield-check" size={18} />{t.why.guarantee.title}</figcaption>
      </figure>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <div class="hero__photo">
        <Image src={photo} alt="" width={960} widths={[480, 720, 960]} sizes="(min-width: 1024px) 520px, 90vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="hero__card">
        <p class="hero__card-title">{t.hero.card.title}</p>
        <ol>
          {t.hero.card.steps.map((s, i) => (
            <li><span>{i + 1}</span>{s}</li>
          ))}
        </ol>
        <p class="hero__card-foot"><Icon name="whatsapp" size={16} />{t.hero.card.replies}</p>
      </div>
      <div class="hero__chip">
        <Icon name="shield-check" size={20} />
        <span>{t.why.guarantee.title}</span>
      </div>
    </div>
  </div>

  <div class="container">
    <dl class="stats">
      {STATS.map((s) => (
        <div class="stats__item">
          <dt>{s[lang]}</dt>
          <dd dir="ltr">{s.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(1200px 600px at 85% -10%, rgba(209, 173, 69, 0.16), transparent 60%),
      radial-gradient(900px 500px at 0% 110%, rgba(36, 71, 124, 0.7), transparent 60%),
      var(--navy);
    color: var(--on-dark-muted);
    padding-block: 36px 0;
  }
  .hero__glow {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: linear-gradient(to bottom, black, transparent 80%);
    -webkit-mask-image: linear-gradient(to bottom, black, transparent 80%);
    pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(234, 213, 125, 0.3);
    background: rgba(234, 213, 125, 0.08);
    color: var(--gold-hl);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .hero__title {
    margin-top: 18px;
    color: #fff;
    font-size: clamp(2rem, 1.2rem + 4vw, 3.6rem);
    line-height: 1.25;
  }
  :global(html[lang='en']) .hero__title {
    line-height: 1.08;
  }
  .hero__title span {
    display: block;
  }
  .hero__sub {
    margin-top: 18px;
    max-width: 560px;
    font-size: 1.0625rem;
    color: var(--on-dark-muted);
  }
  .hero__ctas {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }
  .hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    margin-top: 24px;
    font-size: 0.9375rem;
    color: #e3e8f1;
  }
  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero__points :global(.icon) {
    color: var(--gold);
  }

  .hero__visual {
    position: relative;
    display: none;
  }
  .hero__mobile-photo {
    position: relative;
    margin: 28px 0 0;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 16 / 11;
  }
  .hero__mobile-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__mobile-chip {
    position: absolute;
    inset-inline-start: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--gold-grad);
    color: var(--navy);
    font-weight: 700;
    font-size: 0.875rem;
    box-shadow: var(--shadow-gold);
  }
  .hero__photo {
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 4 / 4.4;
  }
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__card {
    position: absolute;
    inset-inline-start: -28px;
    bottom: 36px;
    width: 250px;
    padding: 18px 20px;
    border-radius: 20px;
    background: #fff;
    color: var(--text);
    box-shadow: var(--shadow-lg);
  }
  .hero__card-title {
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .hero__card ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
    font-size: 0.9375rem;
  }
  .hero__card li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero__card li span {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--gold-soft);
    color: var(--gold-ink);
    font-weight: 700;
    font-size: 0.8125rem;
  }
  .hero__card-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--ok);
    font-weight: 600;
  }
  .hero__chip {
    position: absolute;
    inset-inline-end: -16px;
    top: 28px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--gold-grad);
    color: var(--navy);
    font-weight: 700;
    font-size: 0.9375rem;
    box-shadow: var(--shadow-gold);
  }

  .stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin: 44px 0 0;
    border-radius: 20px 20px 0 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 0;
  }
  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    padding: 20px 12px;
    text-align: center;
  }
  .stats__item:nth-child(odd) {
    border-inline-end: 1px solid rgba(255, 255, 255, 0.08);
  }
  .stats__item:nth-child(-n + 2) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .stats dd {
    margin: 0;
    font-size: clamp(1.625rem, 1.2rem + 1.6vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
    background: var(--gold-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stats dt {
    margin-top: 6px;
    font-size: 0.875rem;
    color: var(--on-dark-muted);
  }

  @media (min-width: 560px) {
    .hero__ctas {
      display: flex;
      flex-wrap: wrap;
    }
  }
  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
    .stats__item {
      border-bottom: 0 !important;
      border-inline-end: 1px solid rgba(255, 255, 255, 0.08);
    }
    .stats__item:last-child {
      border-inline-end: 0;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      padding-top: 72px;
    }
    .hero__grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 72px;
    }
    .hero__visual {
      display: block;
    }
    .hero__mobile-photo {
      display: none;
    }
    .stats {
      margin-top: 72px;
    }
  }
</style>
