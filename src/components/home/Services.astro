---
import ServiceCard from '../ServiceCard.astro';
import Icon from '../Icon.astro';
import { SERVICES, CATEGORIES, type Category, type Lang } from '../../data/services';
import { ui, waLink } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const order: Category[] = ['home', 'specialised', 'property'];
---

<section class="section" id="services">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{t.services.eyebrow}</p>
      <h2 class="h2">{t.services.title}</h2>
      <p class="lead">{t.services.sub}</p>
    </div>

    {order.map((cat) => (
      <div class="svc-group reveal">
        <h3 class="svc-group__title">{CATEGORIES[cat][lang]}</h3>
        <div class="svc-grid">
          {SERVICES.filter((s) => s.category === cat).map((s) => (
            <ServiceCard service={s} lang={lang} badge={s.featured ? t.services.popular : undefined} />
          ))}
        </div>
      </div>
    ))}

    <div class="svc-cta reveal">
      <a class="btn btn--gold btn--lg" href={waLink(t.wa.general)} target="_blank" rel="noopener" data-wa="services">
        <Icon name="whatsapp" size={22} />
        {t.cta.whatsapp}
      </a>
      <a class="btn btn--outline btn--lg" href="#booking">
        <Icon name="calculator" size={20} />
        {t.cta.quote}
      </a>
    </div>
  </div>
</section>

<style>
  .svc-group + .svc-group {
    margin-top: 36px;
  }
  .svc-group__title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.125rem;
    margin-bottom: 16px;
  }
  .svc-group__title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }
  .svc-grid {
    display: grid;
    gap: 12px;
  }
  .svc-cta {
    display: grid;
    gap: 12px;
    margin-top: 40px;
  }
  @media (min-width: 560px) {
    .svc-cta {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
  @media (min-width: 768px) {
    .svc-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  @media (min-width: 1100px) {
    .svc-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
