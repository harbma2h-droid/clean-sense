---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { teamSectionPhoto as teamPhoto } from '../../lib/photos';
import { ui } from '../../i18n/ui';
import type { Lang } from '../../data/services';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang].team;
---

{teamPhoto && (
  <section class="section" id="team">
    <div class="container team">
      <figure class="team__photo reveal">
        <Image src={teamPhoto} alt={t.alt} width={1200} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 600px, 92vw" loading="lazy" />
      </figure>
      <div class="team__copy reveal">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 class="h2">{t.title}</h2>
        <p class="lead">{t.text}</p>
        <ul class="check-list">
          {t.points.map((p) => <li><Icon name="circle-check" size={20} />{p}</li>)}
        </ul>
      </div>
    </div>
  </section>
)}

<style>
  .team {
    display: grid;
    gap: 28px;
    align-items: center;
  }
  .team__photo {
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--line);
    aspect-ratio: 4 / 3;
    background: var(--navy);
  }
  .team__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .team .check-list {
    margin-top: 20px;
  }
  @media (min-width: 1024px) {
    .team {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 64px;
    }
  }
</style>
